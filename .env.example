# Copy this file to .env before running Docker Compose.
BROKER_URL=mqtt://broker:1883
SIMULATOR_INTERVAL=1000

# Leave these blank when the local EMQX broker permits anonymous MQTT access.
GRAFANA_MQTT_USERNAME=
GRAFANA_MQTT_PASSWORD=

# Development-only InfluxDB bootstrap settings.
INFLUXDB_INIT_USERNAME=admin
INFLUXDB_INIT_PASSWORD=ephoros-dev-password
INFLUXDB_INIT_ORG=ephoros
INFLUXDB_INIT_BUCKET=telemetry
INFLUXDB_TOKEN=ephoros-dev-token
